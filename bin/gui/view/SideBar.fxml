<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<VBox fx:id="sideBar" prefWidth="150.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.Controller.SideBarCTRL">

   <children>
      <VBox fx:id="sidePanel" spacing="35.0" style="-fx-background-color: WHITE;">

         <padding>
            <Insets bottom="20" left="20" right="20" top="20" />
         </padding>

         <clip>
            <Rectangle height="1000" width="200" />
         </clip>

         <children>
            <Text style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-fill: #333;" text="WELCOME" />

            <Button onAction="#GoToDashboard" prefHeight="38" prefWidth="138" styleClass="sidebar-button" stylesheets="@../style/style.css" text="Dashboard">
               <font>
                  <Font size="12" />
               </font>
            </Button>

            <Button onAction="#GoToJoinSession" prefHeight="38" prefWidth="135" styleClass="sidebar-button" stylesheets="@../style/style.css" text="Join Session" />

            <Button onAction="#GoToPrivateSession" prefHeight="38" prefWidth="138" styleClass="sidebar-button" stylesheets="@../style/style.css" text="Join Private Session" />

            <Button onAction="#GoToCreateSession" prefHeight="38" prefWidth="147" styleClass="sidebar-button" stylesheets="@../style/style.css" text="Create New Session" />

            <Button onAction="#GoToLogout" prefHeight="38" prefWidth="147" text="LOG OUT">
               <styleClass>
                  <String fx:value="sidebar-button logout-btn" />
                  <String fx:value="sidebar-button" />
               </styleClass>
               <stylesheets>
                  <URL value="@../style/style.css" />
                  <URL value="@../style/style.css" />
               </stylesheets></Button>

            <Region VBox.vgrow="ALWAYS" />
         </children>
      </VBox>
   </children>
</VBox>
