<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane stylesheets="@../style/style.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.Controller.MakeSessCTRL">

    <!-- Main vertical container -->
    <VBox alignment="TOP_CENTER" spacing="20" StackPane.alignment="TOP_CENTER">
        
        <!-- EMPTY STATE CARD -->
        <VBox fx:id="emptyCard" alignment="CENTER" maxWidth="400" spacing="15" style="-fx-background-color: #f5f5f5; -fx-padding: 30; -fx-background-radius: 20;">
            <Label text="Create New Session" />
            <Label fx:id="Label2" styleClass="empty-label" text="No session created" />
            <Button fx:id="addNewBtn" onAction="#AddNewSess" styleClass="add-button" text="+ Add New Session" />
         <VBox.margin>
            <Insets top="300.0" />
         </VBox.margin>
        </VBox>

        <!-- Scrollable session container - REMOVED fixed height -->
        <ScrollPane fx:id="scrollPane" fitToWidth="true" hbarPolicy="NEVER" style="-fx-background: transparent; -fx-background-color: transparent; -fx-border-color: transparent;" vbarPolicy="AS_NEEDED" VBox.vgrow="ALWAYS">
            <content>
                <VBox fx:id="sessionContainer" alignment="TOP_CENTER" spacing="15" style="-fx-padding: 10 20 10 20;" />
            </content>
        </ScrollPane>

    </VBox>

    <!-- Floating Add New Button -->
    <Button fx:id="floatingAddBtn" mnemonicParsing="false" onAction="#AddNewSess" style="-fx-background-color: white;" text="╋" StackPane.alignment="TOP_RIGHT">
        <font>
            <Font name="System Bold" size="18.0" />
        </font>
        <StackPane.margin>
            <Insets right="15.0" top="15.0" />
        </StackPane.margin>
    </Button>

    <!-- Refresh Button -->
    <Button fx:id="refreshBtn" mnemonicParsing="false" onAction="#refresh" style="-fx-background-color: white;" text="⟳" StackPane.alignment="TOP_RIGHT">
        <font>
            <Font name="System Bold" size="18.0" />
        </font>
        <StackPane.margin>
            <Insets right="60.0" top="15.0" />
        </StackPane.margin>
    </Button>

</StackPane>