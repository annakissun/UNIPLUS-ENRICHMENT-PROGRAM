<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane stylesheets="@../style/style.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.Controller.MakeSessCTRL">

                <!-- Main vertical container -->
    <VBox alignment="CENTER" prefWidth="800" spacing="20">

                             <!-- EMPTY STATE CARD -->
        <VBox fx:id="emptyCard" alignment="CENTER" maxWidth="600" spacing="20" style="-fx-background-color: #f5f5f5; -fx-padding: 40; -fx-background-radius: 20;">
            <Label text="Create New Session" />
            <Label fx:id="Label2" styleClass="empty-label" text="No session created" />
            <Button fx:id="addmoreBtn" onAction="#AddNewSess" styleClass="add-button" text="+ Add New Session" />
        </VBox>
          <VBox fx:id="sessionContainer" alignment="TOP_CENTER" spacing="15" style="-fx-padding: 10 20 10 20;" />

                </VBox>
   <Button fx:id="addmoreBtn" mnemonicParsing="false" onAction="#AddNewSess" style="-fx-background-color: white;" text="╋" StackPane.alignment="TOP_RIGHT">
      <font>
         <Font name="System Bold" size="18.0" />
      </font>
      <StackPane.margin>
         <Insets right="15.0" top="15.0" />
      </StackPane.margin>
   </Button>
   <Button fx:id="addmoreBtn1" layoutX="762.0" layoutY="25.0" mnemonicParsing="false" onAction="#refresh" style="-fx-background-color: white;" text="⟳" StackPane.alignment="TOP_RIGHT">
      <font>
         <Font name="System Bold" size="18.0" />
      </font>
      <StackPane.margin>
         <Insets right="60.0" top="15.0" />
      </StackPane.margin>
   </Button>
</StackPane>
