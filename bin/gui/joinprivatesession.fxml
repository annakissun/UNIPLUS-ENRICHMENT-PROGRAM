<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<BorderPane fx:id="root" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.joinprivatesessionpage">

    <!-- TOP BAR WITH TOGGLE BUTTON -->
    <top>
        <HBox style="-fx-background-color: white; -fx-padding: 10;">
         <children>
               <Button fx:id="toggleButton" onAction="#togglePanel" style="-fx-font-weight: bold; -fx-font-size: 14; -fx-background-color: linear-gradient(    to right,    #8DB9FF,    #D3C2FF,    #FFC1E8); -fx-text-fill: white; -fx-background-radius: 5; -fx-padding: 8 15;" text="&lt;&lt; Hide" />
         </children>
        </HBox>
    </top>
    
    <!-- CENTER CONTENT -->
    <center>
        <StackPane fx:id="contentPane">
            <!-- Welcome and Dashboard Section -->
            <VBox alignment="CENTER" spacing="20" style="-fx-padding: 30;">
                <!-- Welcome Section -->
                <VBox alignment="CENTER" spacing="10" />
                
                <!-- Registered Class Section (Empty/No classes registered) -->
                <VBox alignment="CENTER" spacing="20.0" style="-fx-padding: 20 0;">
               <VBox alignment="CENTER" spacing="20.0" style="-fx-background-color: #f5f5f5; -fx-padding: 40; -fx-background-radius: 20; -fx-alignment: center;">
                  <VBox.margin>
                     <Insets />
                  </VBox.margin>
                  <children>
                          <Label alignment="CENTER" contentDisplay="CENTER" prefHeight="54.0" prefWidth="349.0" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #555;" text="Join Private Session">
                        <font>
                           <Font size="26.0" />
                        </font>
                     </Label>
                     <Label alignment="CENTER" contentDisplay="CENTER" text="Please enter private session code below " />
                     <TextField fx:id="usernameField" alignment="CENTER" maxHeight="80.0" maxWidth="251.0" minHeight="26.0" prefHeight="38.0" prefWidth="251.0" style="-fx-background-color: D8EEFF;" />
                     <Button fx:id="createButton" maxWidth="200.0" onAction="#createSession" prefHeight="46.0" prefWidth="200.0" style="-fx-background-color: linear-gradient(    to right,    #8DB9FF,    #D3C2FF,    #FFC1E8);" text="JOIN" textFill="WHITE">
                        <font>
                           <Font name="System Bold" size="12.0" />
                        </font>
                     </Button>
                  </children>
               </VBox>
                </VBox>
            </VBox>
           
           <!-- SIDE PANEL -->
           <VBox fx:id="sidePanel" prefHeight="408.0" prefWidth="174.0" spacing="35.0" style="-fx-background-color: WHITE;">
               <padding>
               <Insets bottom="20" left="20" right="20" top="20" />
            </padding>
                 <Text style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-fill: #333;" text="WELCOME" />
            
            <Button onAction="#handleDashboard" prefHeight="38.0" prefWidth="138.0" style="-fx-background-color: transparent; -fx-background-radius: 5; -fx-padding: 10;" text="Dashboard">
               <font>
                  <Font name="System Bold" size="12.0" />
               </font>
            </Button>
               
            <Button onAction="#handleRegisterClass" prefHeight="38.0" prefWidth="135.0" style="-fx-background-color: white; -fx-font-weight: bold; -fx-background-radius: 5; -fx-padding: 10;" text="Join Session" />
            
            <Button onAction="#handleJoinClass" prefHeight="38.0" prefWidth="138.0" style="-fx-background-color: linear-gradient(    to right,    #8DB9FF,    #D3C2FF,    #FFC1E8); -fx-background-radius: 5; -fx-padding: 10;" text="Join Private Session">
               <font>
                  <Font name="System Bold Italic" size="12.0" />
               </font></Button>
            
            <Button onAction="#handleMakeClass" prefHeight="38.0" prefWidth="147.0" style="-fx-background-color: white; -fx-font-weight: bold; -fx-background-radius: 5; -fx-padding: 10;" text="Create New Session">
               <font>
                  <Font name="System Bold Italic" size="12.0" />
               </font>
            </Button>
            
            <Button onAction="#handleLogout" prefHeight="38.0" prefWidth="147.0" style="-fx-background-color: white; -fx-font-weight: bold; -fx-background-radius: 5; -fx-padding: 10;" text="LOG OUT" />
            
               <Region VBox.vgrow="ALWAYS" />
               
               <!-- CLIP FOR SMOOTH ANIMATION -->
               <clip>
                   <Rectangle height="1000" width="200" />
               </clip>
           </VBox>
        </StackPane>
    </center>

</BorderPane>
