<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<BorderPane fx:id="root" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.addnewsessionpage">

    <!-- TOP BAR WITH TOGGLE BUTTON -->
    <top>
        <HBox style="-fx-background-color: white; -fx-padding: 10;">
         <children>
               <Button fx:id="toggleButton" onAction="#togglePanel" style="-fx-font-weight: bold; -fx-font-size: 14; -fx-background-color: linear-gradient(    to right,    #8DB9FF,    #D3C2FF,    #FFC1E8); -fx-text-fill: white; -fx-background-radius: 5; -fx-padding: 8 15;" text="&lt;&lt; Hide" />
         </children>
        </HBox>
    </top>
    
    <!-- CENTER CONTENT -->
    <center>
        <StackPane fx:id="contentPane" alignment="CENTER">
            
            <!-- FORM CARD - DI TENGAH -->
            <VBox fx:id="card" alignment="CENTER" maxHeight="450.0" maxWidth="640.0" prefHeight="450.0" prefWidth="640.0" spacing="20" 
                  style="-fx-background-radius: 20; -fx-background-color: rgba(255,255,255,0.85); -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.25), 20, 0, 0, 8); -fx-padding: 40 0 40 0;">
               <children>
                  <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #333333;" text="ADD NEW SESSION" />
                  <Label alignment="CENTER" contentDisplay="CENTER" text="Please enter session details below " />
                  <TextField fx:id="subjectField" maxWidth="251.0" prefHeight="38.0" prefWidth="251.0" promptText="Subject" style="-fx-background-color: #D8EEFF; -fx-background-radius: 8; -fx-border-radius: 8; -fx-padding: 0 15 0 15;" />
                  <TextField fx:id="locationField" maxWidth="251.0" prefHeight="38.0" prefWidth="251.0" promptText="Location" style="-fx-background-color: #D8EEFF; -fx-background-radius: 8; -fx-border-radius: 8; -fx-padding: 0 15 0 15;" />
                  <TextField fx:id="descriptionField" maxWidth="251.0" prefHeight="38.0" prefWidth="251.0" promptText="Description" style="-fx-background-color: #D8EEFF; -fx-background-radius: 8; -fx-border-radius: 8; -fx-padding: 0 15 0 15;" />
                  <TextField fx:id="timeField" maxWidth="251.0" prefHeight="38.0" prefWidth="251.0" promptText="Time" style="-fx-background-color: #D8EEFF; -fx-background-radius: 8; -fx-border-radius: 8; -fx-padding: 0 15 0 15;" />
                  <Button fx:id="signupButton" maxWidth="200" onAction="#createSession" prefHeight="45" prefWidth="200" style="-fx-background-color: linear-gradient(to right, #8DB9FF, #D3C2FF, #FFC1E8); -fx-background-radius: 8;" text="CREATE" textFill="WHITE">
                     <font>
                        <Font name="System Bold" size="14.0" />
                     </font>
                  </Button>
               </children>
            </VBox>

           <!-- SIDE PANEL -->
           <VBox fx:id="sidePanel" prefHeight="408.0" prefWidth="174.0" spacing="35.0" style="-fx-background-color: WHITE;">
               <padding>
               <Insets bottom="20" left="20" right="20" top="20" />
            </padding>
                 <Text style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-fill: #333;" text="WELCOME" />
            <Button layoutX="30.0" layoutY="251.0" onAction="#handleDashboard" prefHeight="38.0" prefWidth="138.0" style="-fx-background-color: transparent; -fx-background-radius: 5; -fx-padding: 10;" text="Dashboard">
               <font>
                  <Font name="System Bold" size="12.0" />
               </font>
            </Button>
               
                                             <Button onAction="#handleRegisterClass" prefHeight="38.0" prefWidth="135.0" style="-fx-background-color: white; -fx-font-weight: bold; -fx-background-radius: 5; -fx-padding: 10;" text="Join Session" />
               <Button onAction="#handleJoinClass" prefHeight="38.0" prefWidth="138.0" style="-fx-background-color: white; -fx-font-weight: bold; -fx-background-radius: 5; -fx-padding: 10;" text="Join Private Session" />
               <Button onAction="#handleMakeClass" prefHeight="38.0" prefWidth="147.0" style="-fx-background-color: linear-gradient(    to right,    #8DB9FF,    #D3C2FF,    #FFC1E8); -fx-font-weight: bold; -fx-background-radius: 5; -fx-padding: 10;" text="Create New Session">
               <font>
                  <Font name="System Bold Italic" size="12.0" />
               </font>
            </Button>
               <Button onAction="#handleLogout" prefHeight="38.0" prefWidth="147.0" style="-fx-background-color: white; -fx-font-weight: bold; -fx-background-radius: 5; -fx-padding: 10;" text="LOG OUT" />
               <Region VBox.vgrow="ALWAYS" />
               
                                             <!-- CLIP FOR SMOOTH ANIMATION -->
               <clip>
                   <Rectangle height="1000" width="200" />
               </clip>
           </VBox>
           
        </StackPane>
    </center>

</BorderPane>