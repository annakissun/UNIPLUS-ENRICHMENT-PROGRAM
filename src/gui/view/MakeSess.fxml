<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane stylesheets="@../style/style.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.Controller.MakeSessCTRL">

                <!-- Main vertical container -->
    <VBox alignment="CENTER" prefWidth="800" spacing="20">

                             <!-- EMPTY STATE CARD -->
        <VBox fx:id="emptyCard" alignment="CENTER" maxWidth="600" spacing="20" style="-fx-background-color: #f5f5f5; -fx-padding: 40; -fx-background-radius: 20;">
            <Label text="Create New Session" />
            <Label fx:id="Label2" styleClass="empty-label" text="No session created" />
            <Button fx:id="addmoreBtn" onAction="#addMore" styleClass="add-button" text="+ Add New Session" />
        </VBox>
          <VBox fx:id="sessionContainer" alignment="TOP_CENTER" spacing="15" style="-fx-padding: 10 20 10 20;" />

                </VBox>
</StackPane>
