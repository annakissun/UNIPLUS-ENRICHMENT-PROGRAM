<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx/25"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="gui.Controller.AddTestCTRL">

    <ScrollPane fitToWidth="true"
                prefWidth="500"
                prefHeight="450"
                style="-fx-background-color: transparent;">

        <content>
            <VBox fx:id="container"
                  alignment="TOP_CENTER"
                  spacing="15"
                  style="-fx-padding: 40;">

                <Label fx:id="emptyLabel"
                       text="No session created yet"
                       style="-fx-font-size: 18px; -fx-text-fill: #888;" />

                <Button text="Create Session"
                        onAction="#createSession"
                        style="-fx-background-color: #8DB9FF; -fx-text-fill: white;" />

            </VBox>
        </content>

    </ScrollPane>
</StackPane>