<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.text.Font?>

<StackPane fx:id="root" stylesheets="@../style/style.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.Controller.DashBoardCTRL">
   <children>
      <Rectangle />
      <VBox alignment="CENTER" prefHeight="200.0" prefWidth="100.0">
         <children>
            <VBox fx:id="emptyBox" alignment="CENTER" maxWidth="600.0" spacing="20.0" style="-fx-background-color: #f5f5f5; -fx-padding: 40; -fx-background-radius: 20; -fx-alignment: center;">
               <children>
                  <Label alignment="CENTER" contentDisplay="CENTER" prefHeight="54.0" prefWidth="349.0" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #555;" text="Registered Session">
                     <font>
                        <Font size="26.0" />
                     </font>
                  </Label>
                  <Label alignment="CENTER" contentDisplay="CENTER" text="No registered classes yet" />
               </children>
            </VBox>
            <VBox fx:id="sessContainer" spacing="15.0" />
         </children>
      </VBox>
      <Button alignment="CENTER" mnemonicParsing="false" onAction="#refresh" style="-fx-background-color: white;" stylesheets="@../style/style.css" text="⟳" StackPane.alignment="TOP_RIGHT">
         <font>
            <Font name="System Bold" size="18.0" />
         </font>
         <StackPane.margin>
            <Insets right="15.0" top="15.0" />
         </StackPane.margin>
      </Button>
   </children>
</StackPane>
